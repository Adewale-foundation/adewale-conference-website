AIRTABLE_API_TOKEN=your_airtable_pat_here
AIRTABLE_BASE_ID=""
AIRTABLE_PARTICIPANTS_TABLE_ID=""
AIRTABLE_SPONSORSHIP_TABLE_ID=""
AIRTABLE_SCHOOLS_TABLE_ID=""
# Set to false to skip Airtable writes (testing) without polluting the base.
AIRTABLE_WRITES_ENABLED=true

# SendGrid (confirmation emails). Set ADEWALE_EMAILS_ENABLED=false in dev/staging
# when testing with production-like data and you do not want real inboxes touched.
ADEWALE_EMAILS_ENABLED=true
# Without SENDGRID_API_KEY, sends are skipped silently.
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Must be a SendGrid-verified sender (single sender or domain auth).
ADEWALE_EMAIL_FROM=noreply@asc2026.ng
ADEWALE_EMAIL_FROM_NAME=Adewale Students Conference
# Optional: where replies go.
ADEWALE_REPLY_TO=hello@asc2026.ng
# Optional: BCC every registration/sponsorship confirmation to the organisers.
ADEWALE_NOTIFY_EMAIL=

# NYSC Fellows applications — appended to the team's Google Sheet through an Apps
# Script web app bound to that sheet. See docs/fellows-sheet-setup.md for how to
# create both values. Without them /api/fellows refuses applications rather than
# accepting one it cannot store.
FELLOWS_SHEET_WEBHOOK_URL=
# Also signs the centre-lead attendance cookie (/attendance), via a derived key.
# Centre staff hold no auth user, so this is what stops the cookie being edited
# into another lead's session. Attendance sign-in is refused while it is unset,
# and rotating it signs every centre lead out.
FELLOWS_SHEET_SECRET=

# Signs the Grand Finale fan-vote cookie that brings a supporter back to their
# badge. Its own secret, so rotating it touches nothing else. Generate one with
# `openssl rand -base64 32`. Joining is refused while it is unset.
FINALE_COOKIE_SECRET=

# Sanity CMS — create a free project at https://www.sanity.io/manage, then fill these.
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the Studio and content queries are inert.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Canonical site URL — email links, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.adewaleconference.org

# Supabase (portal auth + DB) — create a free project at https://supabase.com.
# Until these are set, the portal is gated off and the public site runs unchanged.
# Project Settings → API Keys: Project URL + Publishable key (sb_publishable_…,
# replaces the legacy anon key — the legacy var name still works as a fallback).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, replaces service_role) — SERVER ONLY, never exposed.
# Powers the registration→Supabase mirror. Without it, the mirror is skipped.
SUPABASE_SECRET_KEY=

# Supabase CLI (migrations). `npm run db:setup` = link → push.
SUPABASE_PROJECT_REF=            # the ref in your dashboard URL (…/project/<ref>)
SUPABASE_ACCESS_TOKEN=          # personal token: supabase.com/dashboard/account/tokens
# Direct Postgres URL — `npm run db:push:prod` and `npm run check:normalizers
# -- --db-url "$SUPABASE_DB_URL"`. Must be a *session* connection (:5432).
# Project Settings → Database → Connection string (URI). No sample value: a
# user:password@host URI here trips the TruffleHog Postgres detector in CI.
SUPABASE_DB_URL=

# Current edition year — fallback for the active programme run.
ASC_EDITION_YEAR=2026

# Object storage for portal resource files (study packs, lab PDFs, announcement
# attachments). Without these the portal runs unchanged — file uploads are
# refused and external-link resources still work.
#
# RESOURCE_S3_* rather than the bare AWS_* names: this app runs on Vercel, whose
# functions run on Lambda, and Lambda injects AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN / AWS_REGION describing *Vercel's*
# execution role, which cannot reach this bucket. Nothing here reads those names.
#
# The key must belong to the scoped IAM user `adewale-website-s3`
# (Get/Put/DeleteObject on this bucket only) — never a shared or admin key.
RESOURCE_S3_REGION=eu-west-1
RESOURCE_S3_BUCKET=adewale-student-conf
RESOURCE_S3_ACCESS_KEY_ID=
RESOURCE_S3_SECRET_ACCESS_KEY=
